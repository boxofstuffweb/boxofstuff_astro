---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<a href="/" class="footer-logo">BoxOfStuff<span class="tld">.com</span></a>
		<span class="sep">·</span>
		<span>Premium domain available for acquisition</span>
		<span class="sep">·</span>
		<a href="/blog">Blog</a>
		<span class="sep">·</span>
		<a href="mailto:domains@christoc.com">domains@christoc.com</a>
	</div>
	<div class="footer-copy">&copy; {today.getFullYear()} Christoc.com. All rights reserved.</div>
</footer>

<style>
	footer {
		background: #07070d;
		border-top: 1px solid rgba(255,255,255,0.06);
		padding: 2rem;
		text-align: center;
	}
	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		font-size: 0.875rem;
		color: #475569;
		margin-bottom: 0.5rem;
	}
	.footer-logo {
		font-weight: 700;
		color: #64748b;
		text-decoration: none;
	}
	.tld { color: #f59e0b; }
	.sep { color: #334155; }
	.footer-inner a {
		color: #64748b;
		text-decoration: none;
	}
	.footer-inner a:hover { color: #94a3b8; }
	.footer-copy { font-size: 0.75rem; color: #334155; }
</style>
