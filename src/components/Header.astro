---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo">BoxOfStuff<span class="tld">.com</span></a>
		<div class="links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<a href="/#make-offer" class="cta-link">Make an Offer</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: #0c0c14;
		border-bottom: 1px solid rgba(255,255,255,0.08);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		height: 60px;
	}
	.logo {
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 1.05rem;
		font-weight: 800;
		color: #fff;
		text-decoration: none;
		letter-spacing: -0.02em;
	}
	.tld { color: #f59e0b; }
	.links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.links :global(a) {
		color: #94a3b8;
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		padding: 0.4rem 0.75rem;
		border-radius: 6px;
		border-bottom: none;
		transition: color 0.15s;
	}
	.links :global(a:hover),
	.links :global(a.active) {
		color: #e2e8f0;
		border-bottom: none;
	}
	.cta-link {
		background: #f59e0b !important;
		color: #0c0c14 !important;
		font-weight: 700 !important;
		margin-left: 0.5rem;
	}
	.cta-link:hover { background: #fbbf24 !important; }
</style>
